# AgriSense AI - environment variables (ALL OPTIONAL for local use)
#
# Copy this file to `.env` and edit it:      cp .env.example .env
# `.env` is git-ignored. NEVER put a real key in THIS file - it is committed to Git.
# On a hosting platform, set these in its dashboard instead of using a file
# (see docs/deployment.md).

# --- Local server (only used by `python app.py`) ---
AGRISENSE_HOST=127.0.0.1
AGRISENSE_PORT=5000
# 1 = Flask debug mode (auto-reload, detailed errors). Local use ONLY.
AGRISENSE_DEBUG=0

# --- Production (set these on your host; leave unset locally) ---
# "production" turns on long static caching and HSTS.
# AGRISENSE_ENV=production
# 1 when behind Render/Heroku/nginx/etc., so real client IPs and https are detected.
# AGRISENSE_BEHIND_PROXY=1
# Your public address, no trailing slash. Used for canonical URLs, sitemap.xml and
# social cards. Set it once you know your final URL (e.g. your custom domain).
# SITE_URL=https://your-domain.example
# Search Console / Bing Webmaster "HTML tag" verification tokens (the content="..." value only).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# Where runtime data (caches, per-visitor history) is stored. Point at a persistent
# disk if your host has one; default is ./data
# AGRISENSE_DATA_DIR=/var/data
# Per-visitor history/farm-profile folders idle this many days are deleted (0 = never).
# AGRISENSE_USER_DATA_RETENTION_DAYS=90
# 0 disables the per-IP rate limiter (not recommended on a public site).
# AGRISENSE_RATE_LIMIT=1

# --- AgriSense Assistant chatbot (optional) ---
# Free, no-card key from https://console.groq.com -> API Keys. Leave blank to disable
# the chat widget (everything else still works).
LLM_API_KEY=
# Any OpenAI-compatible provider works; change URL + model together.
LLM_MODEL=openai/gpt-oss-20b
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_TIMEOUT_SECONDS=20

# --- Market prices (Revenue & Return estimate) ---
# Optional. Blank uses data.gov.in's shared public sample key (works, but rate-limited).
# Get your own free key: https://data.gov.in -> sign up -> My Account -> API Key.
DATA_GOV_IN_API_KEY=
MARKET_PRICE_TIMEOUT=10
